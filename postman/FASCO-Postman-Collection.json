{
  "info": {
    "name": "FASCO API",
    "description": "FASCO e-commerce — Express + MongoDB + JWT. Base URL: http://localhost:5000/api",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/signup",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Asha\",\n  \"lastName\": \"Verma\",\n  \"email\": \"asha@example.com\",\n  \"phone\": \"+91 98765 43210\",\n  \"password\": \"secret123\"\n}"
            }
          }
        },
        {
          "name": "Login (demo)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.token) pm.collectionVariables.set('token', j.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@fasco.com\",\n  \"password\": \"demo123\"\n}"
            }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/forgot",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Demo\",\n  \"lastName\": \"Shopper\",\n  \"email\": \"demo@fasco.com\"\n}"
            }
          }
        },
        {
          "name": "Verify Code",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/verify",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@fasco.com\",\n  \"code\": \"123456\"\n}"
            }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/reset",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@fasco.com\",\n  \"code\": \"123456\",\n  \"password\": \"newpass123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List All",
          "request": { "method": "GET", "url": "{{baseUrl}}/products" }
        },
        {
          "name": "Search",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?search=dress&sort=price-asc",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "search", "value": "dress" },
                { "key": "sort", "value": "price-asc" }
              ]
            }
          }
        },
        {
          "name": "By ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/products/p01" }
        },
        {
          "name": "Related",
          "request": { "method": "GET", "url": "{{baseUrl}}/products/related/p02" }
        }
      ]
    },
    {
      "name": "Orders (Auth)",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/orders",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lines\": [\n    {\n      \"productId\": \"p02\",\n      \"name\": \"Mini Dress With Ruffled Straps\",\n      \"color\": \"Red\",\n      \"size\": \"M\",\n      \"qty\": 2,\n      \"price\": 14.9\n    }\n  ],\n  \"subtotal\": 29.8,\n  \"discount\": 0,\n  \"shipping\": 40,\n  \"total\": 69.8,\n  \"address\": {\n    \"firstName\": \"Demo\",\n    \"lastName\": \"Shopper\",\n    \"country\": \"United States\",\n    \"address\": \"221B Baker Street\",\n    \"city\": \"London\",\n    \"postal\": \"10001\"\n  }\n}"
            }
          }
        },
        {
          "name": "My Orders",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/orders",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          }
        }
      ]
    },
    {
      "name": "Newsletter",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/newsletter",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"michael@ymail.com\"\n}"
        }
      }
    }
  ]
}
